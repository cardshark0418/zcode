# Local overrides for zcode (DO NOT COMMIT real secrets)
#
# Copy next to this file as application-local.yml:
#   copy application-local.yml.example application-local.yml
#
# Default Spring profile is `local`, so this file is picked up automatically when present.
# Prefer environment variables in shared / CI environments.

zcode:
  llm:
    api: anthropic
    base-url: https://api.anthropic.com
    api-key: your-api-key-here
    model: claude-opus-4-6
    max-tokens: 8192
    timeout-seconds: 180
  agent:
    # chat | read-only | default | auto-confirm
    permission-mode: auto-confirm
  code-index:
    enabled: true
    qdrant-url: http://127.0.0.1:6333
    embed:
      # 阿里云百炼 OpenAI 兼容（北京）；新加坡用 dashscope-intl.aliyuncs.com
      # https://help.aliyun.com/zh/model-studio/embedding-interfaces-compatible-with-openai
      base-url: https://dashscope.aliyuncs.com/compatible-mode/v1
      api-key: your-dashscope-api-key-here
      model: text-embedding-v4


